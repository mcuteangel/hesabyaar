{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "armeabi-v7a:arm64-v8a"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "gradle",
        "gradle-wrapper"
      ],
      "groupName": "gradle dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "cargo dependencies"
    },
    {
      "matchManagers": [
        "gradle",
        "gradle-wrapper"
      ],
      "ignoreUnstable": false,
      "allowedVersions": "/^\\d+(\\.\\d+)*(-(alpha|Beta|beta|rc|RC|preview|eap|milestone|m|M)[-.]?\\d*)?$/"
    }
  ]
}
