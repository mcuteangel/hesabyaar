#!/usr/bin/env bash

set -euo pipefail

# pre-push hook: OpenCodeReview (ocr) review gate.
# Runs `ocr review` on the branch diff before every push and BLOCKS the push
# when the review reports findings at a blocking severity.
#
# Installed from scripts/pre-push by the `copyGitHooks` Gradle task
# (runs automatically on prepare/preBuild tasks).
# Requires: the ocr CLI (`npm install -g @alibaba-group/open-code-review`)
#   and OCR_LLM_TOKEN in the environment — the same value as the repo secret
#   OCR_LLM_AUTH_TOKEN. OCR_LLM_URL / OCR_LLM_MODEL default below to the same
#   free Kilo gateway the repo's OpenCodeReview Action uses, so only the token
#   is per-machine configuration.
#   OCR_LLM_MODEL defaults to a fast free model (benchmarked pick); if that
#   model can't run the review, OCR_LLM_FALLBACK_MODEL (default kilo-auto/free)
#   is tried once.
# Bypass once (not recommended): git push --no-verify

if [ -z "${BASE_REF:-}" ]; then
  # Dynamically resolve default branch from origin/HEAD; fallback to origin/main.
  REMOTE_HEAD="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|^refs/remotes/origin/||' || true)"
  if [ -n "$REMOTE_HEAD" ]; then
    BASE_REF="origin/$REMOTE_HEAD"
  else
    BASE_REF="origin/main"
  fi
fi

# Severities that block the push (comma-separated; critical,high,medium,low).
BLOCK_SEVERITIES="critical,high"

# Configurable gate behavior: default fail-open (0) so missing tools/network
# don't block developer pushes; set OCR_STRICT_GATE=1 to fail-closed (exit 1).
: "${OCR_STRICT_GATE:=0}"

fail_open_or_block() {
  local msg="$1"
  if [ "$OCR_STRICT_GATE" = "1" ]; then
    echo "✖ $msg (OCR_STRICT_GATE=1 — push BLOCKED)." >&2
    exit 1
  fi
  echo "⚠ $msg (push continues)."
  exit 0
}

# 1. Never break pushes on a machine without the CLI (unless strict mode requested).
if ! command -v ocr >/dev/null 2>&1; then
  echo "  Install: npm install -g @alibaba-group/open-code-review"
  fail_open_or_block "ocr CLI not found — skipping pre-push review"
fi

if ! command -v python3 >/dev/null 2>&1; then
  fail_open_or_block "python3 not found — cannot parse ocr output, skipping gate"
fi

# 2. LLM config: mirror the repo's OpenCodeReview Action
#    (.github/workflows/ocr-review.yml). Only the token is per-machine.
: "${OCR_LLM_URL:=https://api.kilo.ai/api/gateway}"
: "${OCR_LLM_MODEL:=cohere/north-mini-code:free}"
: "${OCR_LLM_FALLBACK_MODEL:=kilo-auto/free}"
: "${OCR_LLM_USE_ANTHROPIC:=false}"
: "${OCR_TIMEOUT:=300}"
export OCR_LLM_URL OCR_LLM_MODEL OCR_LLM_FALLBACK_MODEL OCR_LLM_USE_ANTHROPIC OCR_TIMEOUT
# Same as the repo's OpenCodeReview Action: never self-update the CLI
# in the background during a push (a racing update once broke a CI run).
export OCR_NO_UPDATE=1
# Make Python print Unicode status marks even on Windows consoles with a
# legacy code page (cp1252); otherwise the parser crashes on ✔/✖/⚠.
export PYTHONIOENCODING=utf-8
if [ -z "${OCR_LLM_TOKEN:-}" ]; then
  echo "  Use the same value as the repo secret OCR_LLM_AUTH_TOKEN, e.g.:"
  echo "    export OCR_LLM_TOKEN=\"<token>\"   # add to ~/.bashrc to persist"
  fail_open_or_block "OCR_LLM_TOKEN is not set — skipping pre-push review"
fi

# 3. Resolve the base ref; fetch once if missing.
if ! git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
  echo "⚠ cannot resolve $BASE_REF — fetching origin…"
  TARGET_BRANCH="${BASE_REF#origin/}"
  if ! git fetch origin "$TARGET_BRANCH" --quiet 2>/dev/null && ! git fetch origin main --quiet; then
    fail_open_or_block "fetch failed — skipping pre-push review"
  fi
fi

# 4. Nothing new on this branch vs base → nothing to review.
COUNT="$(git rev-list --count "$BASE_REF"..HEAD 2>/dev/null || echo 0)"
if [ "$COUNT" -eq 0 ]; then
  exit 0
fi

# 5. Same rule set the Action enforces, when present in this clone.
# Array is initialized with elements so expansion under `set -u` is safe on bash 3.2.
OCR_CMD=(ocr review --from "$BASE_REF" --to HEAD --audience agent --format json)
if [ -f ".github/ocr-rules.json" ]; then
  OCR_CMD+=(--rule ".github/ocr-rules.json")
fi

# 6. Run the review. The JSON report is parsed below — the CLI exit code is
#    not a findings signal (it returns 0 even when the run itself failed).
#    If the primary model can't run the review, the fallback model is tried once.
OUT="$(mktemp 2>/dev/null)" || {
  fail_open_or_block "cannot create temp file — skipping gate"
}

# Gate decision from the JSON report in $OUT.
# $1: --signal-retry (exit 4 when the review didn't run) or --final.
# Exit codes: 0 = push, 3 = block on findings, 4 = review didn't run (retryable).
parse_report() {
  python3 - "$OUT" "$BLOCK_SEVERITIES" "$1" <<'PYEOF'
import json, sys
if hasattr(sys.stdout, 'reconfigure'):
    sys.stdout.reconfigure(encoding='utf-8', errors='replace')
out_path, block = sys.argv[1], set(s.strip().lower() for s in sys.argv[2].split(','))
signal_retry = sys.argv[3] == '--signal-retry'
try:
    with open(out_path, encoding='utf-8') as f:
        d = json.load(f)
except Exception as e:
    if signal_retry:
        sys.exit(4)
    print(f"⚠ could not parse ocr output ({e}) — skipping gate (push continues).")
    sys.exit(0)
status = d.get('status')
if status and status not in ('complete', 'partial'):
    if signal_retry:
        sys.exit(4)
    print(f"⚠ ocr review could not run (status={status}): {d.get('message', 'unknown error')}")
    print("  skipping gate (push continues).")
    sys.exit(0)
if status == 'partial':
    print(f"⚠ ocr review partially complete: {d.get('message', 'some checks timed out or failed')}")
comments = d.get('comments') or []
summary = d.get('summary') if isinstance(d.get('summary'), dict) else {}
n_files = summary.get('files_reviewed', '?')
if not comments:
    print(f"✔ ocr review clean — {n_files} file(s) reviewed, pushing.")
    sys.exit(0)
blocked = [c for c in comments if str(c.get('severity', '')).lower() in block]
print(f"✖ ocr review: {len(comments)} finding(s), {len(blocked)} at blocking severity [{','.join(sorted(block))}].")
for c in comments:
    sev = str(c.get('severity', '?')).upper()
    cat = c.get('category', '?')
    where = f"{c.get('path', '?')}:{c.get('start_line') or c.get('end_line') or '?'}"
    head = (c.get('content') or '').strip().splitlines()
    print(f"  [{sev} · {cat}] {where} — {head[0][:160] if head else ''}")
if blocked:
    print("  push BLOCKED. Fix the findings above, then push again.")
    print("  To skip this check once: git push --no-verify")
    sys.exit(3)
print("  No blocking-severity findings — pushing.")
sys.exit(0)
PYEOF
}

echo "▶ ocr review --from $BASE_REF --to HEAD ($COUNT commits, model $OCR_LLM_MODEL)…"
set +e
ERR="$(mktemp 2>/dev/null)" || ERR=""
run_ocr() {
  local -a exec_cmd=()
  if command -v timeout >/dev/null 2>&1; then
    exec_cmd=(timeout "$OCR_TIMEOUT" "${OCR_CMD[@]}")
  else
    exec_cmd=("${OCR_CMD[@]}")
  fi

  if [ -n "$ERR" ]; then
    "${exec_cmd[@]}" -o "$OUT" 2>"$ERR"
    ocr_code=$?
    if [ "$ocr_code" -eq 124 ]; then
      echo "⚠ ocr review timed out after ${OCR_TIMEOUT}s:"
      tail -n 10 "$ERR"
    elif [ "$ocr_code" -ne 0 ] && [ -s "$ERR" ]; then
      echo "⚠ ocr review failed (exit $ocr_code):"
      tail -n 10 "$ERR"
    fi
  else
    "${exec_cmd[@]}" -o "$OUT" >/dev/null 2>&1
  fi
}
cleanup_tmp() { rm -f "$OUT" ${ERR:+"$ERR"}; }
trap cleanup_tmp EXIT INT TERM
run_ocr
parse_report --signal-retry
code=$?
if [ "$code" -eq 4 ] && [ -n "$OCR_LLM_FALLBACK_MODEL" ] && [ "$OCR_LLM_FALLBACK_MODEL" != "$OCR_LLM_MODEL" ]; then
  echo "⚠ review with $OCR_LLM_MODEL failed — retrying once with $OCR_LLM_FALLBACK_MODEL…"
  OCR_LLM_MODEL="$OCR_LLM_FALLBACK_MODEL" run_ocr
  parse_report --final
  code=$?
fi
set -e
trap - EXIT INT TERM
cleanup_tmp
if [ "$code" -eq 3 ]; then
  exit 1
elif [ "$code" -ne 0 ]; then
  echo "⚠ review gate crashed (python exit $code) — skipping gate (push continues)."
fi
exit 0
