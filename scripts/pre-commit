#!/usr/bin/env bash

set -euo pipefail

# Backup state for the Rust worktree materialization. Declared at script scope
# so the EXIT trap can always clean it up, even on a crash. Paths live only in
# these Bash arrays. A Git path may contain spaces, tabs, quotes, brackets, or
# newlines, so no newline-delimited path file is ever written or parsed here.
rust_backup_dir=""
RUST_DIRTY_FILES=()     # tracked rust/ inputs whose worktree differed from the index
RUST_UNTRACKED_FILES=() # non-ignored untracked files under rust/
declare -A RUST_DIRTY_MODES=() # permission bits of each dirty input in octal before backup

# Backup state for Kotlin worktree materialization. Declared at script scope
# so the EXIT trap can clean it up on crash, abort, or interruption.
# Recovery state is persisted across invocations via marker files in $GIT_DIR:
#   - hesabyar-kt-backup: one line with the backup directory path
#   - hesabyar-kt-restore-failed: presence means prior restore failed (no content)
KT_RECOVERY_POINTER="hesabyar-kt-backup"
KT_RECOVERY_FAILED="hesabyar-kt-restore-failed"
kt_backup_dir=""
kt_restore_failed=0
KT_DIRTY_FILES=()        # staged Kotlin files whose worktree differed from index
KT_ABSENT_FILES=()       # staged Kotlin files absent from worktree before hook ran
declare -A KT_DIRTY_MODES=() # permission bits of each dirty Kotlin file in octal
declare -A KT_BACKED_UP=()   # files whose backup copy completed successfully

# Resolve the Git directory path lazily. The hook always runs inside a git
# repo (pre-commit), so this never fails in practice. Centralizing avoids
# global capture timing issues.
get_git_dir() {
  git rev-parse --git-dir 2>/dev/null || echo ""
}

# Restore every Kotlin file touched by Kotlin materialization back to its
# original worktree state. Idempotent: a second call is a no-op.
restore_kt_worktree() {
  local git_dir
  git_dir=$(get_git_dir)
  local b="$kt_backup_dir"
  local f
  local restore_failed=0

  # Recover persisted backup pointer from prior interrupted invocation if not set
  if [[ -z "$b" && -n "$git_dir" && -f "$git_dir/$KT_RECOVERY_POINTER" ]]; then
    local saved_b
    saved_b=$(head -n 1 "$git_dir/$KT_RECOVERY_POINTER" 2>/dev/null || echo "")
    if [[ -n "$saved_b" && -d "$saved_b" ]]; then
      b="$saved_b"
      kt_backup_dir="$b"
    else
      rm -f "$git_dir/$KT_RECOVERY_POINTER" 2>/dev/null || true
    fi
  fi

  # Recover persisted restore-failure flag from prior invocation
  if [[ -n "$git_dir" && -f "$git_dir/$KT_RECOVERY_FAILED" ]]; then
    kt_restore_failed=1
  fi

  [[ -n "$b" && -d "$b" ]] || return 0

  # Cross-invocation recovery: reconstruct dirty file list from modes.null.
  # modes.null is appended only AFTER a file's backup copy completes, so it is
  # the authoritative record of completed backups. Never scan tracked/ directly:
  # a partial cp left by an interrupted run would otherwise be treated as a
  # complete backup and overwrite the untouched worktree file.
  if [[ -f "$b/modes.null" ]]; then
    if [[ ${#KT_DIRTY_MODES[@]} -eq 0 ]]; then
      # Parse as NUL-delimited mode/path pairs so filenames with spaces round-trip.
      local rec_mode rec_path
      while IFS= read -r -d '' rec_mode && IFS= read -r -d '' rec_path; do
        [[ -n "$rec_path" && "$rec_mode" =~ ^[0-7]{1,4}$ ]] || continue
        KT_DIRTY_MODES["$rec_path"]="$rec_mode"
        if [[ ${#KT_DIRTY_FILES[@]} -eq 0 ]]; then
          KT_DIRTY_FILES+=("$rec_path")
        fi
      done < "$b/modes.null"
    fi
  fi
  if [[ -f "$b/absent.null" && ${#KT_ABSENT_FILES[@]} -eq 0 ]]; then
    while IFS= read -r -d '' f; do
      [[ -n "$f" ]] && KT_ABSENT_FILES+=("$f")
    done < "$b/absent.null"
  fi

  # If restore previously failed and no tracked, absent, or mode data remain,
  # there is nothing to retry. Return failure so the caller knows the backup
  # state is unrecoverable.
  if [[ $kt_restore_failed -ne 0 && ${#KT_DIRTY_FILES[@]} -eq 0 && ${#KT_ABSENT_FILES[@]} -eq 0 && ${#KT_DIRTY_MODES[@]} -eq 0 ]]; then
    return 1
  fi

  kt_restore_failed=0
  local -a remaining_dirty=()
  if [[ ${#KT_DIRTY_FILES[@]} -gt 0 ]]; then
    for f in "${KT_DIRTY_FILES[@]}"; do
      # When restoring within the same invocation, only restore files whose
      # backup copy completed successfully (KT_BACKED_UP is populated). On
      # cross-invocation recovery, KT_BACKED_UP is empty because the in-memory
      # state was not persisted, so trust any discovered file under tracked/.
      if [[ ${#KT_BACKED_UP[@]} -gt 0 && -z "${KT_BACKED_UP[$f]:-}" ]]; then
        echo "⚠️ Skipping restore of '$f': no completed backup copy." >&2
        continue
      fi
      if [[ -f "$b/tracked/$f" ]]; then
        if ! mkdir -p "$(dirname "$f")" 2>/dev/null || ! cp "$b/tracked/$f" "$f" 2>/dev/null; then
          restore_failed=1
          remaining_dirty+=("$f")
          echo "❌ Failed to restore Kotlin file '$f' from '$b/tracked/$f'." >&2
          continue
        fi
        local m="${KT_DIRTY_MODES[$f]:-}"
        if [[ "$m" =~ ^[0-7]{1,4}$ ]]; then
          chmod "$m" "$f" 2>/dev/null || true
        fi
      fi
    done
    KT_DIRTY_FILES=("${remaining_dirty[@]}")
  fi

  if [[ ${#KT_ABSENT_FILES[@]} -gt 0 ]]; then
    local -a remaining_absent=()
    for f in "${KT_ABSENT_FILES[@]}"; do
      # Only delete if the worktree file matches the staged index version
      # that the hook materialized. If the user edited the file in the meantime,
      # do not delete user edits.
      if [[ -e "$f" ]] && ! git diff --quiet -- "$f" 2>/dev/null; then
        echo "⚠️ Preserving modified worktree file '$f' originally flagged absent." >&2
        continue
      fi
      if ! rm -f "$f" 2>/dev/null; then
        remaining_absent+=("$f")
      fi
    done
    KT_ABSENT_FILES=("${remaining_absent[@]}")
  fi

  if [[ $restore_failed -eq 0 && ${#KT_DIRTY_FILES[@]} -eq 0 && ${#KT_ABSENT_FILES[@]} -eq 0 ]]; then
    rm -rf "$b"
    kt_backup_dir=""
    kt_restore_failed=0
    [[ -n "$git_dir" ]] && rm -f "$git_dir/$KT_RECOVERY_POINTER" "$git_dir/$KT_RECOVERY_FAILED" 2>/dev/null || true
    KT_DIRTY_MODES=()
    KT_BACKED_UP=()
    return 0
  else
    kt_restore_failed=1
    [[ -n "$git_dir" ]] && touch "$git_dir/$KT_RECOVERY_FAILED" 2>/dev/null || true
    echo "⚠️ Retaining Kotlin backup directory '$b' due to restore failure." >&2
    return 1
  fi
}

# Print a file's permission bits as octal digits without leading zeros.
# GNU stat accepts -c. BSD and macOS stat accept -f '%Lp'. The value is
# accepted only when it is pure octal. Returns non-zero when no stat
# variant can read a valid mode. The caller must then abort: a mode that
# was not recorded cannot be restored after materialization.
capture_file_mode() {
  local m
  m=$(stat -c '%a' -- "$1" 2>/dev/null) && [[ "$m" =~ ^[0-7]{1,4}$ ]] && { printf '%s' "$m"; return 0; }
  m=$(stat -f '%Lp' -- "$1" 2>/dev/null) && [[ "$m" =~ ^[0-7]{1,4}$ ]] && { printf '%s' "$m"; return 0; }
  return 1
}

# Restore every rust/ input the Rust block touched back to its original
# worktree state. Idempotent: a second call is a no-op. Nothing here loses
# user data. It copies backups back. It reapplies each saved worktree mode.
# It moves untracked files back. It deletes the index copy of a file that
# was absent before the hook ran.
restore_rust_worktree() {
  local b="$rust_backup_dir"
  [[ -n "$b" && -d "$b" ]] || return 0
  local root f
  root=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
  if [[ -n "$root" ]]; then
    for f in "${RUST_DIRTY_FILES[@]}"; do
      if [[ -f "$b/tracked/$f" ]]; then
        mkdir -p "$(dirname "$root/$f")"
        cp "$b/tracked/$f" "$root/$f"
        # Reapply the worktree mode saved before materialization. checkout-index
        # wrote the index mode and cp keeps the destination mode, so the copy
        # alone cannot restore them. An unknown mode leaves the copy untouched.
        local m="${RUST_DIRTY_MODES[$f]:-}"
        if [[ "$m" =~ ^[0-7]{1,4}$ ]]; then
          chmod "$m" "$root/$f" 2>/dev/null || true
        fi
      else
        # No backup exists, so this file was absent before the hook ran.
        # Delete the index copy the hook materialized for validation.
        rm -f "$root/$f"
      fi
    done
    for f in "${RUST_UNTRACKED_FILES[@]}"; do
      [[ -f "$b/untracked/$f" ]] || continue
      mkdir -p "$(dirname "$root/$f")"
      mv "$b/untracked/$f" "$root/$f"
    done
  fi
  rm -rf "$b"
  RUST_DIRTY_FILES=()
  RUST_UNTRACKED_FILES=()
  RUST_DIRTY_MODES=()
  rust_backup_dir=""
}

cleanup_worktrees() {
  # If an inline restore already failed, do not retry from the EXIT trap
  # to avoid duplicate diagnostics and partial-state re-entry.
  if [[ $kt_restore_failed -eq 0 ]]; then
    restore_kt_worktree || true
  fi
  restore_rust_worktree || true
}

trap cleanup_worktrees EXIT

echo "==========================================="
echo "  Hesabyar — Pre-Commit Hook"
echo "==========================================="

# Run quality gates selected by the staged file types: ktlint and detekt only
# when Kotlin sources are staged, cargo fmt and clippy only when files under
# rust/ are staged. A commit with neither (for example a docs-only commit)
# skips every gate and passes immediately.
try_commit() {
  # Record originally staged files using null-delimited output for safe filename handling
  local staged_files
  mapfile -d '' -t staged_files < <(git diff --cached --name-only -z)

  # Classify the staged set. Kotlin gates cover *.kt, *.kts, and Kotlin/Gradle
  # build and linter configurations. Rust gates cover every path under rust/
  # (sources, manifests, lockfile, toolchain).
  local has_kotlin=0 has_rust=0
  local staged_path
  if [[ ${#staged_files[@]} -gt 0 ]]; then
    for staged_path in "${staged_files[@]}"; do
      case "$staged_path" in
        *.kt|*.kts|*.gradle|\
        gradle.properties|*/gradle.properties|\
        gradle/libs.versions.toml|*/gradle/libs.versions.toml|\
        .editorconfig|*/.editorconfig|\
        gradle/wrapper/*|*/gradle/wrapper/*|\
        config/detekt/*|*/config/detekt/*)
          has_kotlin=1
          ;;
      esac
    done
  fi

  if [[ $has_kotlin -eq 1 ]]; then
    # Identify staged Kotlin files. Exclude staged deletions and files without
    # an active index entry so ktlintFormat cannot undo a deletion or re-stage
    # unstaged deletions into the commit candidate.
    local -a staged_kt=()
    local f
    while IFS= read -r -d '' f; do
      case "$f" in
        *.kt|*.kts)
          if git rev-parse --verify -q ":$f" >/dev/null 2>&1; then
            staged_kt+=("$f")
          fi
          ;;
      esac
    done < <(git diff --cached --diff-filter=d -z --name-only)

    # Clean up any leftover Kotlin backup from a previous attempt.
    # Abort if a prior restore failed so retained state is not clobbered.
    if ! restore_kt_worktree; then
      echo "❌ Leftover Kotlin backup could not be restored." >&2
      echo "   Retained backup directory: '$kt_backup_dir'" >&2
      return 1
    fi

    # Materialize index versions for staged Kotlin files that are dirty
    # or absent in the worktree. This prevents unstaged edits on staged files
    # from being included when auto-fixes are re-staged.
    # Note: Gradle tasks (ktlintFormat, ktlintCheck, detekt) run on the whole
    # project and can modify unstaged Kotlin files in the worktree. Only the
    # staged files are protected against accidental staging of unstaged edits.
    if [[ ${#staged_kt[@]} -gt 0 ]]; then
      local -a dirty_kt=() absent_kt=()
      for f in "${staged_kt[@]}"; do
        if [[ -L "$f" ]]; then
          # A dangling symlink is not -e, so it would enter the absent path
          # and git show would write through the link to its target. Never
          # materialize through a symlink: reject it before any backup runs.
          echo "❌ Staged Kotlin file '$f' is a symbolic link."
          echo "   The hook materializes index content into the worktree and"
          echo "   must not write through a symlink. Replace it with a regular"
          echo "   file and retry."
          restore_kt_worktree
          return 1
        elif [[ ! -e "$f" ]]; then
          absent_kt+=("$f")
        elif ! git diff-files --quiet -- "$f" 2>/dev/null; then
          dirty_kt+=("$f")
        fi
      done

      if [[ ${#dirty_kt[@]} -gt 0 || ${#absent_kt[@]} -gt 0 ]]; then
        kt_restore_failed=0
        kt_backup_dir=$(mktemp -d "${TMPDIR:-/tmp}/hesabyar-kt.XXXXXX") || {
          echo "❌ Could not create a temporary backup directory for Kotlin files."
          return 1
        }
        mkdir -p "$kt_backup_dir/tracked" || {
          echo "❌ Could not create backup directory '$kt_backup_dir/tracked'."
          rm -rf "$kt_backup_dir"
          kt_backup_dir=""
          return 1
        }
        # Persist recovery pointer BEFORE any materialization. This ensures a
        # forced termination (SIGKILL) between here and the backup writes cannot
        # leave staged bytes in the worktree with no way for the next invocation
        # to locate the backup. Abort if the marker cannot be written.
        local git_dir
        git_dir=$(get_git_dir)
        if [[ -n "$git_dir" ]]; then
          if ! printf '%s\n' "$kt_backup_dir" > "$git_dir/$KT_RECOVERY_POINTER" 2>/dev/null; then
            echo "❌ Could not persist Kotlin recovery marker." >&2
            echo "   Aborting before materialization to avoid leaving worktree in an" >&2
            echo "   unrecoverable state." >&2
            rm -rf "$kt_backup_dir"
            kt_backup_dir=""
            return 1
          fi
          # Remove any stale restore-failure marker from a prior attempt
          rm -f "$git_dir/$KT_RECOVERY_FAILED" 2>/dev/null || true
        fi

        # Back up dirty worktree files and their modes before materialization.
        # Track each successfully backed-up file so restore only uses complete
        # copies, avoiding partial cp leftovers.
        for f in "${dirty_kt[@]}"; do
          if ! mkdir -p "$(dirname "$kt_backup_dir/tracked/$f")" || ! cp "$f" "$kt_backup_dir/tracked/$f"; then
            echo "❌ Failed to back up Kotlin file '$f'."
            restore_kt_worktree
            return 1
          fi
          local mode
          if ! mode=$(capture_file_mode "$f"); then
            echo "❌ Cannot capture file mode for '$f'."
            restore_kt_worktree
            return 1
          fi
          KT_DIRTY_FILES+=("$f")
          KT_BACKED_UP["$f"]=1
          KT_DIRTY_MODES["$f"]="$mode"
          printf '%s\0%s\0' "$mode" "$f" >> "$kt_backup_dir/modes.null"
        done

        # Materialize index version for dirty files
        for f in "${dirty_kt[@]}"; do
          if ! git show ":$f" > "$f" 2>/dev/null; then
            echo "❌ Failed to materialize index version for Kotlin file '$f'."
            restore_kt_worktree
            return 1
          fi
        done

        # Materialize index version for files absent from the worktree.
        # Register the path BEFORE the write: the redirection creates or
        # truncates $f even when git show fails, and an interrupt right after
        # the write must still find the path in KT_ABSENT_FILES for cleanup.
        for f in "${absent_kt[@]}"; do
          KT_ABSENT_FILES+=("$f")
          printf '%s\0' "$f" >> "$kt_backup_dir/absent.null"
          if ! mkdir -p "$(dirname "$f")" 2>/dev/null || ! git show ":$f" > "$f" 2>/dev/null; then
            echo "❌ Failed to materialize absent Kotlin file '$f'."
            restore_kt_worktree
            return 1
          fi
        done
      fi
    fi

    # Snapshot the index-version hash AFTER materialization (i.e., the pre-format
    # candidate), then compare after to re-stage only files ktlintFormat changed.
    declare -A pre_format_hash
    if [[ ${#staged_kt[@]} -gt 0 ]]; then
      for f in "${staged_kt[@]}"; do
        if [[ -f "$f" ]]; then
          pre_format_hash["$f"]=$(git hash-object "$f" 2>/dev/null || echo "")
        fi
      done
    fi

    # Run ktlintFormat first to auto-fix formatting
    echo ""
    echo "[1/5] Running ktlintFormat (auto-fix)..."
    if ! ./gradlew ktlintFormat --quiet; then
      echo "❌ ktlintFormat failed — there may be unresolved formatting issues."
      echo "   Run ./gradlew ktlintFormat manually to see details."
      restore_kt_worktree
      return 1
    fi
    echo "  ✓ ktlintFormat passed"

    # Compare post-format hashes to detect files modified by ktlintFormat
    if [[ ${#staged_kt[@]} -gt 0 ]]; then
      local modified_files=()
      for f in "${staged_kt[@]}"; do
        if [[ -f "$f" ]]; then
          local post_hash
          post_hash=$(git hash-object "$f" 2>/dev/null || echo "")
          if [[ -n "${pre_format_hash[$f]:-}" && "${pre_format_hash[$f]}" != "$post_hash" ]]; then
            modified_files+=("$f")
          fi
        fi
      done
      if [[ ${#modified_files[@]} -gt 0 ]]; then
        echo "  Re-staging ${#modified_files[@]} file(s) with auto-fixes..."
        git add "${modified_files[@]}"
      fi
    fi

    # Run ktlintCheck to verify no style violations remain
    echo ""
    echo "[2/5] Running ktlintCheck..."
    if ! ./gradlew ktlintCheck --quiet; then
      echo "❌ ktlintCheck failed — Kotlin style violations detected."
      echo "   Fix the issues manually or re-stage the files and try again."
      restore_kt_worktree
      return 1
    fi
    echo "  ✓ ktlintCheck passed"

    # Run detekt to match CI strictness (whole-project, non-autocorrectable rules)
    echo ""
    echo "[3/5] Running detekt (static analysis)..."
    if ! ./gradlew detekt; then
      echo "❌ detekt failed — code quality issues detected."
      echo "   Fix the issues or run ./gradlew detekt to see details."
      restore_kt_worktree
      return 1
    fi
    echo "  ✓ detekt passed"

    # Restore the original worktree bytes for dirty and absent Kotlin files.
    # A failed restore must abort the commit: the worktree would still hold
    # materialized index bytes, and the backup directory is kept on disk.
    if ! restore_kt_worktree; then
      echo "❌ Failed to restore the original Kotlin worktree state."
      echo "   The backup directory was kept for manual recovery (see above)."
      return 1
    fi
  else
    echo ""
    echo "  No staged Kotlin sources — skipping ktlint and detekt"
  fi

  # Check whether any Rust inputs are staged. Re-evaluate against the live
  # index in case earlier formatting steps updated the staged set.
  if git diff --cached --quiet -- rust/; then
    has_rust=0
  else
    has_rust=1
  fi

  if [[ $has_rust -eq 0 ]]; then
    echo ""
    echo "  No staged Rust sources — skipping cargo fmt and clippy"
    return 0
  fi

  # Cargo must be on PATH. A missing Rust toolchain is a hard failure, never a skip.
  if ! command -v cargo >/dev/null 2>&1; then
    echo "❌ cargo not found — cannot run Rust checks."
    echo "   Install the Rust toolchain (https://rustup.rs), reopen the shell, and retry."
    return 1
  fi

  # The Rust workspace must be present. A missing rust/ directory is a hard
  # failure with a clear hint — never a silent skip.
  if [[ ! -d rust ]]; then
    echo "❌ Rust workspace directory 'rust/' not found."
    echo "   The hook requires a full repository checkout that includes the rust/ workspace."
    echo "   Restore rust/ (or clone the full repository) and retry the commit."
    return 1
  fi

  # ---------------------------------------------------------------------------
  # Index/worktree correctness for the Rust gates.
  #
  # cargo fmt and cargo clippy operate on the WORKTREE. The commit records the
  # INDEX. Two rules follow:
  #   1. The tooling must see the exact commit candidate. Every tracked input
  #      under rust/ whose worktree bytes differ from the index is temporarily
  #      replaced by its index version.
  #   2. The worktree must survive. The original bytes are backed up first and
  #      put back afterwards. This includes files the user deleted without
  #      staging the deletion; their absence is restored too.
  #
  # Rust validation inputs are all tracked files under rust/:
  #   - *.rs sources and build.rs
  #   - Cargo.toml manifests (workspace root and members)
  #   - Cargo.lock
  #   - .cargo/config.toml and rust-toolchain.toml
  # Nothing outside rust/ affects cargo here, so nothing outside rust/ is
  # materialized or moved.
  #
  # The hook saves each dirty file's full permission mode with its content.
  # checkout-index -f writes the index mode to the worktree. On hosts with
  # core.fileMode=true, any unstaged chmod makes the file a dirty input, and
  # a content-only restore would drop that mode. The restore step reapplies
  # the saved octal mode exactly, not just an execute bit. On hosts where
  # chmod cannot represent modes, the reapply is a harmless no-op.
  # ---------------------------------------------------------------------------

  # Clean up any backup left by a previous attempt in this process.
  restore_rust_worktree

  rust_backup_dir=$(mktemp -d "${TMPDIR:-/tmp}/hesabyar-rust.XXXXXX") || {
    echo "❌ Could not create a temporary backup directory for the Rust checks."
    return 1
  }
  mkdir -p "$rust_backup_dir/tracked" "$rust_backup_dir/untracked"

  # Inventory the Rust validation inputs. staged_rs feeds cargo fmt only.
  # dirty_inputs covers every tracked rust/ file whose worktree bytes differ
  # from the index — not just *.rs — so partially staged Cargo.toml,
  # Cargo.lock, build.rs, or toolchain config cannot leak unstaged state into
  # clippy. untracked_rs removes non-ignored untracked files under rust/.
  local -a staged_rs=() dirty_inputs=() untracked_rs=()
  local f
  while IFS= read -r -d '' f; do
    [[ "$f" == rust/* ]] && staged_rs+=("$f")
  done < <(git diff --cached -z --name-only -- '*.rs')
  while IFS= read -r -d '' f; do
    dirty_inputs+=("$f")
  done < <(git diff-files -z --name-only -- rust/)
  while IFS= read -r -d '' f; do
    untracked_rs+=("$f")
  done < <(git ls-files -z --others --exclude-standard -- rust/)

  # Snapshot the pre-fmt index blob OID of each staged Rust file.
  declare -A staged_oid
  for f in "${staged_rs[@]}"; do
    staged_oid["$f"]=$(git ls-files -s -- "$f" | awk '{print $2}')
  done

  # Back up the original worktree bytes of every dirty input. A missing file
  # records an absent state: the user deleted it without staging. We must not
  # copy a nonexistent file; restore deletes our materialized copy instead.
  # For each present file, also record its full permission mode. Git tracks
  # only one execute class per file, but Unix worktrees can carry richer
  # modes such as 0740, and checkout-index -f is about to overwrite them
  # with the index mode.
  #
  # A mode that cannot be captured is a hard failure here, BEFORE any
  # materialization. The hook has only written inside the backup directory
  # at this point, so discarding it leaves the worktree untouched. The EXIT
  # trap then sees an empty backup dir and does nothing.
  for f in "${dirty_inputs[@]}"; do
    if [[ -f "$f" ]]; then
      mkdir -p "$(dirname "$rust_backup_dir/tracked/$f")"
      cp "$f" "$rust_backup_dir/tracked/$f"
      local mode
      if ! mode=$(capture_file_mode "$f"); then
        echo "❌ Cannot capture file mode for '$f'."
        echo "   Neither 'stat -c %a' nor 'stat -f %Lp' returned a valid octal mode."
        echo "   The hook will not replace worktree files whose mode it cannot"
        echo "   record and put back. Install a working 'stat' and retry."
        rm -rf "$rust_backup_dir"
        RUST_DIRTY_FILES=()
        RUST_UNTRACKED_FILES=()
        RUST_DIRTY_MODES=()
        rust_backup_dir=""
        return 1
      fi
      RUST_DIRTY_MODES["$f"]="$mode"
    fi
    RUST_DIRTY_FILES+=("$f")
  done
  if [[ ${#dirty_inputs[@]} -gt 0 ]]; then
    git checkout-index -f -- "${dirty_inputs[@]}"
  fi

  # Move untracked files out of the rust/ subtree. They are not part of the
  # commit candidate, and a stray manifest or source could alter validation.
  # They are moved back when the checks finish.
  for f in "${untracked_rs[@]}"; do
    mkdir -p "$(dirname "$rust_backup_dir/untracked/$f")"
    mv "$f" "$rust_backup_dir/untracked/$f"
    RUST_UNTRACKED_FILES+=("$f")
  done

  # Run cargo fmt. Only format staged sources so an unrelated Kotlin commit
  # does not rewrite the whole Rust worktree. cargo fmt selects the toolchain
  # via rust/rust-toolchain.toml because the subshell starts inside rust/.
  echo ""
  echo "[4/5] Running cargo fmt (auto-fix)..."
  local -a fmt_paths=()
  for f in "${staged_rs[@]}"; do
    # A staged deletion has no worktree file. Exclude it from the rustfmt
    # path list; the deletion stays in the index untouched.
    [[ -f "$f" ]] && fmt_paths+=("${f#rust/}")
  done
  if [[ ${#fmt_paths[@]} -eq 0 ]]; then
    echo "  No staged Rust sources to format — skipping cargo fmt"
  else
    if ! (cd rust && cargo fmt -- "${fmt_paths[@]}"); then
      echo "❌ cargo fmt failed."
      echo "   Run (cd rust && cargo fmt) manually to see details."
      restore_rust_worktree
      return 1
    fi
    echo "  ✓ cargo fmt passed"

    # Re-stage only the formatting delta for staged Rust files. Because the
    # worktree was materialized from the index, `git add` here cannot pull in
    # unrelated unstaged edits — those are backed up and restored later.
    local -a to_restage=()
    local post_oid
    for f in "${staged_rs[@]}"; do
      [[ -f "$f" ]] || continue
      post_oid=$(git hash-object --path="$f" -- "$f" 2>/dev/null || echo "")
      if [[ -n "${staged_oid[$f]}" && "${staged_oid[$f]}" != "$post_oid" ]]; then
        to_restage+=("$f")
      fi
    done
    if [[ ${#to_restage[@]} -gt 0 ]]; then
      echo "  Re-staging ${#to_restage[@]} Rust file(s) with auto-fixes..."
      git add "${to_restage[@]}"
    fi
  fi

  # Run clippy against the worktree, which now equals the (formatted) commit
  # candidate. Unrelated unstaged edits are excluded by materialization.
  echo ""
  echo "[5/5] Running cargo clippy (static analysis)..."
  if ! (cd rust && cargo clippy --workspace --all-targets --all-features -- -D warnings); then
    echo "❌ cargo clippy failed — Rust code quality issues detected."
    echo "   Fix the issues or run: (cd rust && cargo clippy --workspace --all-targets --all-features)"
    restore_rust_worktree
    return 1
  fi
  echo "  ✓ cargo clippy passed"

  restore_rust_worktree
  return 0
}

# Loop until all checks pass
while true; do
  if try_commit; then
    break
  fi

  # If worktree restore failed, do not prompt retry — worktree is in broken state
  if [[ $kt_restore_failed -ne 0 ]]; then
    echo "❌ Worktree restoration failed. Aborting commit." >&2
    exit 1
  fi

  # Ask user to fix issues and re-stage files
  echo ""
  read -r -p "Fix issues and stage files? (y/n): " choice
  case "$choice" in
    y|Y)
      echo "Continuing..."
      ;;
    n|N)
      echo "Aborting commit."
      exit 1
      ;;
    *)
      echo "Invalid input. Please answer y or n."
      ;;
  esac
done

echo ""
echo "==========================================="
echo "  All checks passed! Proceeding with commit."
echo "==========================================="
